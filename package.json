{
  "name": "@ksmith221/openclaw-xmpp",
  "version": "0.1.0",
  "description": "XMPP DM channel plugin for OpenClaw",
  "type": "module",
  "license": "MIT",
  "author": "Kevin Smith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksmith221/openclaw-xmpp.git"
  },
